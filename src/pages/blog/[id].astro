---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { isGuide } from '../../data/content-policy.mjs';
import { tools } from '../../data/tools';
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const guides = posts
    .filter(post => isGuide(post.id))
    .sort((a, b) => (b.data.updatedDate ?? b.data.pubDate).valueOf() - (a.data.updatedDate ?? a.data.pubDate).valueOf());

  return posts.map(post => {
    const guideIndex = guides.findIndex(g => g.id === post.id);
    const nextPost = guideIndex !== -1 ? guides[(guideIndex + 1) % guides.length] : undefined;
    const currentTool = tools.find(tool => tool.guide === post.id || tool.id === post.id);
    const otherGuides = guides.filter(g => g.id !== post.id && g.id !== nextPost?.id);
    const relatedPosts = otherGuides
      .sort((a, b) => {
        const aTool = tools.find(tool => tool.guide === a.id || tool.id === a.id);
        const bTool = tools.find(tool => tool.guide === b.id || tool.id === b.id);
        const aSame = aTool?.category === currentTool?.category ? 1 : 0;
        const bSame = bTool?.category === currentTool?.category ? 1 : 0;
        return bSame - aSame;
      })
      .slice(0, 2);

    return {
      params: { id: post.id },
      props: { post, nextPost, relatedPosts },
    };
  });
}
const { post, nextPost, relatedPosts = [] } = Astro.props;
const { Content } = await render(post);
const guide = isGuide(post.id);
const related = tools.filter(tool => tool.guide === post.id || tool.id === post.id);
const url = new URL(`/blog/${post.id}/`, Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate.toISOString() } : {}),
  author: { '@type': 'Organization', name: 'GlowPunch', url: 'https://glowpunch.net/about/' },
  publisher: { '@type': 'Organization', name: 'GlowPunch', url: 'https://glowpunch.net/' },
  image: 'https://glowpunch.net/og-image.png',
  mainEntityOfPage: url,
  inLanguage: 'ja',
};
---
<BaseLayout title={`${post.data.title} | GlowPunch`} description={post.data.description} noindex={!guide} article>
  <nav aria-label="パンくず" class="text-sm"><a href="/" class="underline">ホーム</a> / <a href="/blog/" class="underline">ガイド・記事</a> / <span>{guide ? '実用ガイド' : '公開履歴'}</span></nav>
  <article class="glass-panel p-6 md:p-10 max-w-3xl mx-auto w-full">
    <header class="mb-8"><p class="text-sm text-sky-700 mb-3">{guide ? '実用ガイド' : '公開・開発のお知らせ'}</p><h1 class="text-3xl md:text-4xl font-bold text-slate-800 leading-snug mb-5">{post.data.title}</h1><p class="text-lg leading-relaxed mb-4">{post.data.description}</p><p class="text-sm text-slate-600">執筆・管理：<a class="underline" href="/about/">GlowPunch</a></p><p class="text-sm text-slate-600 mt-2">公開：<time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('ja-JP', { timeZone: 'UTC' })}</time>{post.data.updatedDate && <> ／ 更新：<time datetime={post.data.updatedDate.toISOString()}>{post.data.updatedDate.toLocaleDateString('ja-JP', { timeZone: 'UTC' })}</time></>}</p></header>
    {!guide && <aside class="bg-slate-50 border border-slate-200 rounded-xl p-4 mb-6 text-sm">この記事は公開時のお知らせです。現行の仕様は関連ツールをご確認ください。形式の判断やトラブル対応は<a href="/blog/" class="underline">実用ガイド</a>にまとめています。</aside>}
    <div class="prose prose-slate max-w-none prose-headings:text-slate-800 prose-a:text-sky-800"><Content /></div>
    <footer class="border-t border-slate-200 mt-8 pt-6 flex flex-col gap-8">
      {nextPost && (
        <nav aria-label="次のおすすめ記事" class="bg-sky-50/70 border border-sky-200 rounded-2xl p-5 hover:border-sky-400 transition-colors">
          <p class="text-xs font-bold text-sky-700 tracking-wide mb-1">次のおすすめ記事</p>
          <a href={`/blog/${nextPost.id}/`} class="block group">
            <h2 class="text-lg md:text-xl font-bold text-slate-800 group-hover:text-sky-800 transition-colors mb-2">
              {nextPost.data.title} <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span>
            </h2>
            <p class="text-sm text-slate-600 leading-relaxed">{nextPost.data.description}</p>
          </a>
        </nav>
      )}
      {relatedPosts.length > 0 && (
        <section aria-labelledby="related-guides-heading">
          <h2 id="related-guides-heading" class="text-xl font-bold mb-4 text-slate-800">関連コンテンツ・おすすめ実用ガイド</h2>
          <div class="grid sm:grid-cols-2 gap-4">
            {relatedPosts.map(item => (
              <a href={`/blog/${item.id}/`} class="p-4 rounded-xl border border-slate-200 bg-white/80 hover:border-sky-500 hover:bg-white block transition-all group">
                <h3 class="font-bold text-sm text-sky-800 group-hover:underline mb-1.5 leading-snug">{item.data.title}</h3>
                <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">{item.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}
      {related.length > 0 && (
        <section aria-labelledby="related-tools-heading">
          <h2 id="related-tools-heading" class="text-xl font-bold mb-3 text-slate-800">関連するツール</h2>
          <ul class="flex flex-wrap gap-3">
            {related.map(tool => (
              <li>
                <a href={`/tools/${tool.id}/`} class="px-3.5 py-1.5 rounded-lg border border-slate-200 bg-white text-sm text-sky-800 hover:border-sky-400 hover:bg-sky-50/50 font-medium inline-block transition-colors">
                  {tool.name}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <p class="text-sm text-slate-500 pt-4 border-t border-slate-200">
        記載内容の誤り・補足は<a href="/contact/" class="underline">訂正窓口</a>へ。処理対象の機密ファイルは添付しないでください。
      </p>
    </footer>
  </article>
  <a href="/blog/" class="underline text-sky-800">ガイド・記事一覧へ戻る</a>
  {guide && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
</BaseLayout>
