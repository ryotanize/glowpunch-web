  <script>
    function setupInteractivePreview() {
      const tabs = document.querySelectorAll<HTMLButtonElement>('.preview-tab');
      const panels = document.querySelectorAll<HTMLElement>('.preview-panel');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const targetTab = tab.getAttribute('data-tab');
          if (!targetTab) return;

          tabs.forEach((t) => {
            t.className = 'preview-tab px-4 py-2 rounded-xl text-sm font-bold transition-all text-slate-600 bg-slate-100 hover:bg-slate-200';
          });
          tab.className = 'preview-tab px-4 py-2 rounded-xl text-sm font-bold transition-all bg-sky-500 text-white shadow-md shadow-sky-500/20';

          panels.forEach((p) => {
            if (p.id === `panel-${targetTab}`) {
              p.classList.remove('hidden');
              p.classList.add('block');
            } else {
              p.classList.remove('block');
              p.classList.add('hidden');
            }
          });
        });
      });

      const previewInput = document.getElementById('preview-text-input') as HTMLTextAreaElement | null;
      const statChars = document.getElementById('preview-stat-chars');
      const statWords = document.getElementById('preview-stat-words');
      const statLines = document.getElementById('preview-stat-lines');
      const statNoSpace = document.getElementById('preview-stat-nospace');

      function updatePreviewStats() {
        if (!previewInput || !statChars || !statWords || !statLines || !statNoSpace) return;
        const val = previewInput.value;
        statChars.textContent = val.length.toString();
        const words = val.trim() ? val.trim().split(/\s+/).length : 0;
        statWords.textContent = words.toString();
        const lines = val ? val.split('\n').length : 0;
        statLines.textContent = lines.toString();
        const noSpaces = val.replace(/\s/g, '').length;
        statNoSpace.textContent = noSpaces.toString();
      }

      if (previewInput) {
        previewInput.addEventListener('input', updatePreviewStats);
        updatePreviewStats();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupInteractivePreview);
    } else {
      setupInteractivePreview();
    }
  </script>
