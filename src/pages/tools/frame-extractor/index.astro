---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="動画フレーム抽出ツール - GlowPunch"
  description="動画からお気に入りのシーンを高画質な画像として一瞬で抜き出します。サムネイル作成や連続コマ画像の抽出に便利です。"
>
  <div class="flex flex-col gap-6">

    <!-- Header -->
    <div class="mb-2">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-800 tracking-tight mb-2">
        動画フレーム<span class="text-amber-500">抽出 (コマ送り画像)</span>
      </h1>
      <p class="text-slate-600 text-lg">
        動画から特定のシーンを画像（PNG/JPEG）として切り出します。サムネイル用や、1秒ごとの連続画像抽出も可能です。ブラウザ処理のため数GBの動画でも一瞬で読み込めます。
      </p>
    </div>

    <!-- Drop Zone -->
    <div
      id="drop-zone"
      class="glass-panel p-10 flex flex-col items-center justify-center gap-4 border-2 border-dashed border-amber-300 bg-amber-50/30 rounded-2xl cursor-pointer transition-all duration-200 hover:border-amber-400 hover:bg-amber-50/60 min-h-48"
    >
      <div id="drop-icon" class="w-16 h-16 rounded-2xl bg-amber-100 text-amber-500 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
          <circle cx="9" cy="9" r="2"/>
          <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
        </svg>
      </div>
      <div class="text-center">
        <p class="text-slate-700 font-semibold text-lg">動画ファイルをドロップ</p>
        <p class="text-slate-500 text-sm mt-1">MP4, MOV, WebMに対応</p>
      </div>
      <input id="file-input" type="file" accept="video/*" class="hidden" />
    </div>

    <!-- Editor Section (hidden) -->
    <div id="editor-section" class="hidden flex flex-col lg:flex-row gap-6">
      
      <!-- Video Player -->
      <div class="flex-1 glass-panel p-4 flex flex-col gap-4">
        <h3 class="font-bold text-slate-700 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect width="15" height="14" x="1" y="5" rx="2" ry="2"/></svg>
          プレビュー <span id="file-name" class="text-slate-400 text-xs font-normal truncate ml-2 max-w-[200px]"></span>
        </h3>
        
        <div class="relative bg-black rounded-lg overflow-hidden flex items-center justify-center min-h-[300px] border border-slate-800">
          <video id="video-player" class="max-h-[60vh] max-w-full" controls playsinline controlsList="nodownload"></video>
        </div>
      </div>

      <!-- Controls -->
      <div class="w-full lg:w-80 flex flex-col gap-4">
        
        <!-- Single Frame Extraction -->
        <div class="glass-panel p-5 flex flex-col gap-4 relative overflow-hidden">
          <div class="absolute -right-6 -top-6 w-24 h-24 bg-amber-500/10 rounded-full blur-2xl"></div>
          
          <h3 class="font-bold text-slate-800 text-sm tracking-wider flex items-center gap-2 border-b border-slate-100 pb-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-amber-500"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
            単一フレーム抽出
          </h3>
          
          <p class="text-xs text-slate-500">プレイヤーを一時停止して、お気に入りのシーンを表示させた状態で下のボタンを押してください。</p>
          
          <div class="flex gap-2">
            <button id="btn-extract-single" class="flex-1 bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 px-4 rounded-xl transition-all shadow-md hover:-translate-y-0.5 text-sm flex items-center justify-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              現在の画面を保存
            </button>
            <select id="single-format" class="w-24 px-2 py-2 rounded-xl border border-slate-200 bg-white text-slate-800 font-bold text-xs focus:ring-2 focus:ring-amber-400">
              <option value="image/png">PNG</option>
              <option value="image/jpeg">JPEG</option>
            </select>
          </div>
        </div>

        <!-- Sequential Frame Extraction -->
        <div class="glass-panel p-5 flex flex-col gap-4">
          <h3 class="font-bold text-slate-800 text-sm tracking-wider flex items-center gap-2 border-b border-slate-100 pb-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-500"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><path d="M7 3v18"/><path d="M17 3v18"/></svg>
            連続フレーム抽出 (ZIP)
          </h3>
          
          <p class="text-xs text-slate-500">動画全体から一定間隔でコマを切り出し、ZIPファイルにまとめてダウンロードします。</p>

          <div class="flex flex-col gap-2">
            <label class="text-xs font-bold text-slate-600">抽出間隔 (秒)</label>
            <select id="interval-select" class="w-full px-3 py-2 rounded-xl border border-slate-200 bg-white text-slate-800 font-medium text-sm focus:ring-2 focus:ring-indigo-400">
              <option value="1">1秒に1枚 (1 fps)</option>
              <option value="0.5">0.5秒に1枚 (2 fps)</option>
              <option value="5">5秒に1枚</option>
              <option value="10">10秒に1枚</option>
            </select>
          </div>

          <button id="btn-extract-sequence" class="group relative flex items-center justify-center gap-2 bg-indigo-500 hover:bg-indigo-600 text-white font-bold py-3 px-4 rounded-xl transition-all shadow-md hover:-translate-y-0.5 mt-2">
            <span id="seq-btn-text" class="flex items-center gap-2 text-sm z-10">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              一括抽出を開始
            </span>
            <div id="seq-progress-bar" class="absolute left-0 top-0 bottom-0 bg-indigo-600 rounded-xl transition-all duration-200 z-0" style="width: 0%"></div>
          </button>
        </div>

        <canvas id="offscreen-canvas" class="hidden"></canvas>
      </div>
    </div>

    <div class="mt-4">
    </div>
  
    <div class="mt-8 border-t border-slate-200 pt-8">
      <details class="group bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <summary class="flex items-center justify-between p-5 font-bold text-slate-800 cursor-pointer bg-slate-50 hover:bg-slate-100 transition-colors">
          <span>動画フレーム抽出ツールについて（使い方・FAQ）</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-open:-rotate-180 text-slate-500"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </summary>
        <div class="p-6 text-slate-600 space-y-6">
          <div class="prose prose-slate max-w-none">
            <h3>動画フレーム抽出ツールについて</h3>
            <p>動画の好きな瞬間を高品質な静止画として保存できるツールです。YouTubeサムネイル用の画像作成、プレゼン資料への動画キャプチャ挿入、SNS投稿用の写真素材作りなどに最適です。</p>

            <h3>よくある質問 (FAQ)</h3>

            <h4>Q. どのような動画形式に対応していますか？</h4>
            <p>A. MP4、WebM、MOVなど、ブラウザが再生可能な主要な動画形式に対応しています。</p>

            <h4>Q. 抽出した画像の解像度はどうなりますか？</h4>
            <p>A. 元の動画と同じ解像度（フルHD動画なら1920×1080px）で抽出されます。画質の劣化はありません。</p>

            <h4>Q. 連続フレーム抽出とは何ですか？</h4>
            <p>A. 指定した間隔（例：1秒ごと）で動画全体からフレームを連続抽出し、ZIP形式でまとめてダウンロードできる機能です。タイムラプス素材の作成や動画の内容確認に便利です。</p>
          </div>
        </div>
      </details>
    </div>

  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "SoftwareApplication",
          "name": "動画フレーム抽出ツール",
          "operatingSystem": "All",
          "applicationCategory": "MultimediaApplication",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "JPY"
          },
          "description": "動画から特定のシーンを高画質画像として切り出す無料ツールです。サムネイル作成やZIPでの連続抽出にも対応。"
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "どのような動画形式に対応していますか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "MP4、WebM、MOVなど、ブラウザが再生可能な主要な動画形式に対応しています。"
              }
            },
            {
              "@type": "Question",
              "name": "抽出した画像の解像度はどうなりますか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "元の動画と同じ解像度（フルHD動画なら1920×1080px）で抽出されます。画質の劣化はありません。"
              }
            },
            {
              "@type": "Question",
              "name": "連続フレーム抽出とは何ですか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "指定した間隔（例：1秒ごと）で動画全体からフレームを連続抽出し、ZIP形式でまとめてダウンロードできる機能です。タイムラプス素材の作成や動画の内容確認に便利です。"
              }
            }
          ]
        }
      ]
    }
  </script>
</BaseLayout>

<script>
  import JSZip from 'jszip';

  const dropZone = document.getElementById('drop-zone') as HTMLElement;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const editorSection = document.getElementById('editor-section') as HTMLElement;
  const fileNameEl = document.getElementById('file-name') as HTMLElement;
  const videoPlayer = document.getElementById('video-player') as HTMLVideoElement;
  const canvas = document.getElementById('offscreen-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d');

  const btnExtractSingle = document.getElementById('btn-extract-single') as HTMLButtonElement;
  const singleFormat = document.getElementById('single-format') as HTMLSelectElement;

  const btnExtractSeq = document.getElementById('btn-extract-sequence') as HTMLButtonElement;
  const intervalSelect = document.getElementById('interval-select') as HTMLSelectElement;
  const seqBtnText = document.getElementById('seq-btn-text') as HTMLElement;
  const seqProgressBar = document.getElementById('seq-progress-bar') as HTMLElement;

  let currentFile: File | null = null;
  let videoURL: string = "";
  let isExtracting = false;

  // Drag & Drop Handling
  dropZone.addEventListener('click', () => fileInput.click());
  dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-amber-500', 'bg-amber-100/50'); });
  dropZone.addEventListener('dragleave', () => { dropZone.classList.remove('border-amber-500', 'bg-amber-100/50'); });
  dropZone.addEventListener('drop', (e: DragEvent) => {
    e.preventDefault();
    dropZone.classList.remove('border-amber-500', 'bg-amber-100/50');
    const file = e.dataTransfer?.files?.[0];
    if (file && file.type.startsWith('video/')) handleFile(file);
  });
  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) handleFile(file);
  });

  function handleFile(file: File) {
    if (videoURL) URL.revokeObjectURL(videoURL);
    currentFile = file;
    fileNameEl.textContent = file.name;
    videoURL = URL.createObjectURL(file);
    videoPlayer.src = videoURL;
    editorSection.classList.remove('hidden');
  }

  // --- Single Extraction ---
  btnExtractSingle.addEventListener('click', () => {
    if (!currentFile || !ctx) return;
    
    // Set canvas dimensions to match video videoWidth/Height
    canvas.width = videoPlayer.videoWidth;
    canvas.height = videoPlayer.videoHeight;
    ctx.drawImage(videoPlayer, 0, 0, canvas.width, canvas.height);

    const format = singleFormat.value;
    const ext = format === 'image/jpeg' ? 'jpg' : 'png';
    const dataURL = canvas.toDataURL(format, 0.95);
    
    const a = document.createElement('a');
    a.href = dataURL;
    const baseName = currentFile.name.replace(/\.[^/.]+$/, "");
    const timeCode = videoPlayer.currentTime.toFixed(2).replace('.', '_');
    a.download = `${baseName}_${timeCode}s.${ext}`;
    a.click();
  });

  // --- Sequential Extraction ---
  btnExtractSeq.addEventListener('click', async () => {
    if (!currentFile || !ctx || isExtracting) return;
    isExtracting = true;
    
    canvas.width = videoPlayer.videoWidth;
    canvas.height = videoPlayer.videoHeight;

    const interval = parseFloat(intervalSelect.value);
    const duration = videoPlayer.duration;
    const totalFrames = Math.floor(duration / interval) + 1;
    const zip = new JSZip();
    const baseName = currentFile.name.replace(/\.[^/.]+$/, "");
    
    // Save original state
    const originalTime = videoPlayer.currentTime;
    const originalPaused = videoPlayer.paused;
    videoPlayer.pause();

    seqProgressBar.style.width = '0%';
    btnExtractSeq.disabled = true;
    btnExtractSeq.classList.add('cursor-not-allowed');

    let currentTime = 0;
    for (let i = 0; i < totalFrames; i++) {
      seqBtnText.textContent = `描画中... ${i+1}/${totalFrames}`;
      seqProgressBar.style.width = `${(i / totalFrames) * 100}%`;
      
      videoPlayer.currentTime = currentTime;
      // Wait for seek to finish via 'seeked' event
      await new Promise<void>((resolve) => {
        const onSeeked = () => {
          videoPlayer.removeEventListener('seeked', onSeeked);
          // Wait a tiny bit to ensure the frame is ready
          requestAnimationFrame(() => requestAnimationFrame(() => resolve()));
        };
        videoPlayer.addEventListener('seeked', onSeeked);
      });

      ctx.fillRect(0, 0, canvas.width, canvas.height); // clear
      ctx.drawImage(videoPlayer, 0, 0, canvas.width, canvas.height);
      
      const blob = await new Promise<Blob | null>(res => canvas.toBlob(res, "image/jpeg", 0.9));
      if (blob) {
        const timeCode = currentTime.toFixed(1).replace('.', '_');
        zip.file(`${baseName}_${timeCode}s.jpg`, blob);
      }
      
      currentTime += interval;
      if(currentTime > duration) break;
    }

    seqBtnText.textContent = "ZIP圧縮中...";
    seqProgressBar.style.width = '100%';
    seqProgressBar.classList.replace('bg-indigo-600', 'bg-emerald-500');

    try {
      const content = await zip.generateAsync({ type: "blob" });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(content);
      a.download = `${baseName}_frames.zip`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 10000);
    } catch(e) {
      console.error(e);
      alert('ZIPの生成に失敗しました。');
    }

    // Restore
    videoPlayer.currentTime = originalTime;
    if (!originalPaused) videoPlayer.play();

    isExtracting = false;
    btnExtractSeq.disabled = false;
    btnExtractSeq.classList.remove('cursor-not-allowed');
    seqBtnText.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg> 一括抽出を開始`;
    seqProgressBar.style.width = '0%';
    seqProgressBar.classList.replace('bg-emerald-500', 'bg-indigo-600');
  });

</script>
