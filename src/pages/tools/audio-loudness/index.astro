---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TransparencyCard from '../../../components/TransparencyCard.astro';
import ProcessStepLog from '../../../components/ProcessStepLog.astro';
---

<BaseLayout
  title="動画ラウドネスチェッカー（48 kHzステレオ向け参考測定） - GlowPunch"
  description="48 kHzステレオの動画音声をブラウザ内で参考測定し、初期値 -24 LKFS へ全体ゲインを調整するツールです。処理対象ファイルは外部サーバーへアップロードしません。"
>
  <div class="flex flex-col gap-6">

    <!-- Header -->
    <div class="mb-2">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-800 tracking-tight mb-2">
        動画ラウドネス<span class="text-indigo-500">チェッカー＆調整</span>
      </h1>
      <p class="text-slate-600 text-lg">
        48 kHzステレオの動画音声を参考測定し、初期目標値 -24 LKFS へ全体ゲインを調整します。
      </p>
      
      <div class="flex flex-wrap gap-2 mt-4">
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-50 text-indigo-700 text-xs sm:text-sm font-semibold border border-indigo-100">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
          測定から自動調整・保存までワンストップ
        </span>
        <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 text-xs sm:text-sm font-semibold border border-emerald-100">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
          処理対象ファイルはサーバーへアップロードしません
        </span>
      </div>
    </div>

    <!-- Drop Zone -->
    <div
      id="drop-zone"
      class="glass-panel p-10 flex flex-col items-center justify-center gap-4 border-2 border-dashed border-indigo-300 bg-indigo-50/30 rounded-2xl cursor-pointer transition-all duration-200 hover:border-indigo-400 hover:bg-indigo-50/60 min-h-48"
    >
      <div id="drop-icon" class="w-16 h-16 rounded-2xl bg-indigo-100 text-indigo-500 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2v10"/>
          <path d="m16 8-4-4-4 4"/>
          <path d="M2 13a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h20a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2"/>
          <circle cx="12" cy="17" r="1"/>
        </svg>
      </div>
      <div class="text-center">
        <p class="text-slate-700 font-semibold text-lg">動画ファイルをドロップして測定開始</p>
        <p class="text-slate-500 text-sm mt-1 mb-4">MP4, MOV, WebMに対応（最大100MB推奨）</p>
        <p class="text-xs text-slate-500 bg-white/80 backdrop-blur px-4 py-2 rounded-xl shadow-sm inline-block border border-slate-100 font-medium mb-2">
          ファイルを選択しても、アップロードは始まりません。<br class="md:hidden"/>選択したファイルは、あなたのブラウザ内で読み込まれます。
        </p>
      </div>
      <input id="file-input" type="file" accept="video/*" class="hidden" />
    </div>

    <!-- Status / Progress -->
    <div id="status-container" class="hidden glass-panel p-6 flex flex-col gap-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div id="status-spinner" class="w-5 h-5 border-2 border-indigo-300 border-t-indigo-600 rounded-full animate-spin"></div>
          <span id="status-label" class="text-slate-700 font-medium">音声をスキャン中...</span>
        </div>
        <span id="status-pct" class="text-indigo-600 font-bold">0%</span>
      </div>
      <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
        <div id="status-bar" class="h-full bg-indigo-500 transition-all duration-300" style="width: 0%"></div>
      </div>
      <process-step-log id="loudness-log" class="w-full mt-2 text-left"></process-step-log>
    </div>

    <!-- Results Section -->
    <div id="results-section" class="hidden flex flex-col gap-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Integrated Loudness Card -->
        <div class="glass-panel p-6 border-l-4 border-indigo-500 bg-white/50 relative overflow-hidden">
          <div class="relative z-10">
            <h3 class="text-sm font-bold text-slate-500 uppercase tracking-widest mb-1">現在のラウドネス (Integrated)</h3>
            <div class="flex items-baseline gap-2">
              <span id="res-loudness" class="text-5xl font-black text-slate-800">--.-</span>
              <span class="text-xl font-bold text-slate-400 font-mono">LKFS</span>
            </div>
            <p id="res-status-text" class="mt-2 text-sm font-medium"></p>
          </div>
          <!-- Background decoration -->
          <div class="absolute right-[-20px] bottom-[-20px] opacity-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="120" height="120" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 3v18M12 3l-4 4M12 3l4 4"/>
            </svg>
          </div>
        </div>

        <!-- Target Info -->
        <div class="glass-panel p-6 bg-slate-800 text-white">
          <h3 class="text-sm font-semibold text-slate-400 uppercase tracking-widest mb-1">このツールの初期目標値</h3>
          <div class="flex items-baseline gap-2 text-indigo-300">
            <span class="text-4xl font-black">-24.0</span>
            <span class="text-lg font-bold font-mono">LKFS</span>
          </div>
          <p class="mt-2 text-slate-300 text-xs leading-relaxed">
            提出先の基準を確認するための初期値です。EBU R128の運用目標（-23 LUFS）やARIB TR-B32の運用条件と同一視しないでください。
          </p>
        </div>
      </div>

      <!-- Adjustment Box -->
      <div id="adjustment-box" class="glass-panel p-6 flex flex-col gap-5">
        <div class="flex items-center gap-3">
          <div class="w-1.5 h-6 bg-indigo-500 rounded-full"></div>
          <h2 class="text-xl font-bold text-slate-800">ラウドネス調整（ノーマライズ）</h2>
        </div>
        
        <div class="flex flex-col gap-2">
          <p class="text-slate-600 text-sm leading-relaxed">
            測定値を元に音声を再エンコードして全体ゲインを増減し、初期目標値の <span class="font-bold text-indigo-600">-24.0 LKFS</span> に調整します。出力後は再測定と試聴を行ってください。
          </p>
        </div>

        <button
          id="btn-normalize"
          class="inline-flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-4 px-8 rounded-xl transition-all shadow-lg hover:shadow-indigo-200/50 hover:-translate-y-0.5"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          ターゲット値に合わせて調整・保存
        </button>
      </div>
    </div>

    <!-- Error container -->
    <div id="error-container" class="hidden glass-panel p-4 border-l-4 border-red-500 bg-red-50/80">
      <p id="error-msg" class="text-red-700 text-sm font-medium"></p>
    </div>

    <!-- Info Section -->
    <div class="mt-8 border-t border-slate-200 pt-8">
      <div class="mb-8">
        <TransparencyCard />
      </div>
      
      <!-- Hidden Template for Step Log -->
      <ProcessStepLog />
      <details class="group bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden" open>
        <summary class="flex items-center justify-between p-5 font-bold text-slate-800 cursor-pointer bg-slate-50 hover:bg-slate-100 transition-colors">
          <span>動画ラウドネスチェッカーについて（FAQ・解説）</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-open:-rotate-180 text-slate-500"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </summary>
        <div class="p-6 text-slate-600 space-y-6">
          <div class="prose prose-slate max-w-none">
            <h3>このツールの測定範囲と目標値</h3>
            <p>ITU-R BS.1770は番組ラウドネスとTrue Peakを測るためのアルゴリズムです。EBU R128は欧州放送向けの運用Recommendationで、番組ラウドネスの目標は -23 LUFS です。日本のデジタルテレビ放送にはARIB TR-B32の運用規定があります。媒体・納品先の最新仕様は必ず提出先で確認してください。</p>
            <p>このツールは、48 kHz・ステレオの入力に限定したブラウザ内の参考測定と、固定初期値 -24 LKFS への全体ゲイン調整を提供します。True Peak測定、リミッティング、サラウンド／LFEのチャンネル重み付け、認証測定器としての適合確認は行いません。</p>
            <h3>ラウドネス値の確認と調整</h3>
            <ol>
              <li><strong>動画を読み込む:</strong> 48 kHzステレオの対象動画を選択します。</li>
              <li><strong>参考値を確認:</strong> 表示値を提出先の仕様・検証済みの測定環境と照合します。</li>
              <li><strong>全体ゲインを調整:</strong> 出力はAACへ再エンコードされます。再エンコードにより音質が変化する可能性があるため、出力後に再測定・試聴してください。</li>
            </ol>

            <h3>よくある質問 (FAQ)</h3>
            
            <h4>Q. このツールの -24 LKFS はどの規格ですか？</h4>
            <p>A. 固定の初期目標値であり、すべての媒体に共通する規格ではありません。EBU R128の目標値は -23 LUFS で、ARIB TR-B32を含む国内放送の運用条件も提出先や最新版を確認してください。</p>

            <h4>Q. YouTubeやSNSへ投稿するための最適値を保証しますか？</h4>
            <p>A. いいえ。外部プラットフォームの再生時の扱い・投稿要件は変更されることがあります。このツールの結果だけで適合や再生音量を保証せず、各サービスと提出先の最新仕様を確認してください。</p>

            <h4>Q. アップロードした動画や音声データはサーバーに保存されますか？</h4>
            <p>A. 処理対象動画の解析・変換はブラウザ内で実行し、外部サーバーへアップロードしません。サイト配信などの通信は別途発生します。業務データを扱う場合は、所属組織のルール、端末環境、保存先も確認してください。</p>
            
            <p class="text-sm mt-8 p-4 bg-slate-50 rounded-lg border border-slate-100">
              ※本ツールは音声トラック全体へ一定ゲインを加える処理です。True Peakの測定・制限は行いません。ピーク超過やクリッピングの可能性があるため、必要に応じて動画編集ソフト等でリミッター処理を行ってください。
            </p>
          </div>
        </div>
      </details>
    </div>

  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "SoftwareApplication",
          "name": "動画ラウドネスチェッカー＆ノーマライザー",
          "operatingSystem": "All",
          "applicationCategory": "MultimediaApplication",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "JPY"
          },
          "description": "48 kHzステレオの動画音声をブラウザ内で参考測定し、初期値 -24 LKFS へ全体ゲインを調整するツールです。処理対象ファイルは外部サーバーへアップロードしません。"
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "このツールの -24 LKFS はどの規格ですか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "固定の初期目標値であり、すべての媒体に共通する規格ではありません。EBU R128の目標値は -23 LUFS で、ARIB TR-B32を含む国内放送の運用条件も提出先や最新版を確認してください。"
              }
            },
            {
              "@type": "Question",
              "name": "YouTubeやSNSへ投稿するための最適値を保証しますか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "いいえ。外部プラットフォームの再生時の扱い・投稿要件は変更されることがあります。このツールの結果だけで適合や再生音量を保証せず、各サービスと提出先の最新仕様を確認してください。"
              }
            },
            {
              "@type": "Question",
              "name": "対応する音声形式は何ですか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "48 kHz・ステレオ入力に限定しています。True Peak測定、リミッティング、サラウンド／LFEのチャンネル重み付けには対応しないため、認証測定器としての適合確認は行いません。"
              }
            },
            {
              "@type": "Question",
              "name": "アップロードした動画や音声データはサーバーに保存されますか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "処理対象動画の解析・変換はブラウザ内で実行し、外部サーバーへアップロードしません。サイト配信などの通信は別途発生します。業務データを扱う場合は、所属組織のルール、端末環境、保存先も確認してください。"
              }
            }
          ]
        }
      ]
    }
  </script>
</BaseLayout>

<script>
  // @ts-nocheck
  import { createToolEventReporter } from '../../../components/tool-events';
  // DOM References
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input');
  const statusContainer = document.getElementById('status-container');
  const statusBar = document.getElementById('status-bar');
  const statusPct = document.getElementById('status-pct');
  const statusLabel = document.getElementById('status-label');
  const resultsSection = document.getElementById('results-section');
  const resLoudness = document.getElementById('res-loudness');
  const resStatusText = document.getElementById('res-status-text');
  const btnNormalize = document.getElementById('btn-normalize');
  const errorContainer = document.getElementById('error-container');
  const errorMsg = document.getElementById('error-msg');
  const logger = document.getElementById('loudness-log');

  let currentFile = null;
  let measuredLoudness = null;
  let activeAttempt = null;

  const releaseManifest = (() => {
    try {
      const marker = document.getElementById('gp-release-manifest');
      const manifest = marker?.textContent ? JSON.parse(marker.textContent) : undefined;
      return manifest?.schemaVersion === 1 && manifest?.measurementVersion === 1 && /^[a-f0-9]{40}$/.test(manifest?.siteRevision)
        ? manifest
        : undefined;
    } catch {
      return undefined;
    }
  })();
  const reporter = createToolEventReporter({
    siteRevision: releaseManifest?.siteRevision,
    send: (name, params) => window.gpTrackToolEvent?.(name, params),
  });

  // Drag & Drop
  dropZone.onclick = () => fileInput.click();
  dropZone.ondragover = (e) => { e.preventDefault(); dropZone.classList.add('bg-indigo-100/50'); };
  dropZone.ondragleave = () => { dropZone.classList.remove('bg-indigo-100/50'); };
  dropZone.ondrop = (e) => {
    e.preventDefault();
    dropZone.classList.remove('bg-indigo-100/50');
    if (e.dataTransfer.files?.[0]) handleFile(e.dataTransfer.files[0]);
  };

  fileInput.onchange = () => {
    if (fileInput.files?.[0]) handleFile(fileInput.files[0]);
  };

  function handleFile(file) {
    if (!file.type.startsWith('video/')) {
      showError('動画ファイルを指定してください（MP4, MOV, WebMなど）');
      return;
    }
    cancelActiveAttempt();
    currentFile = file;
    startAnalysis();
  }

  function startAnalysis() {
    resetUI();
    statusContainer.classList.remove('hidden');
    
    if (logger && logger.addStep) {
       if (logger.container) {
          logger.container.innerHTML = '';
          logger.container.classList.remove('hidden');
       }
       logger.addStep('read', '動画をブラウザ内に読み込みました', 'done');
       logger.addStep('analyze', '音声をスキャン中...', 'running');
       logger.addStep('normalize', 'ラウドネス自動調整', 'pending');
    }
    
    startWorkerAttempt('analyze', { type: 'analyze', file: currentFile });
  }

  function startWorkerAttempt(operation, message) {
    cancelActiveAttempt();
    const event = reporter.start(operation);
    const attempt = { operation, event, worker: null, complete: false };
    activeAttempt = attempt;
    try {
      attempt.worker = new Worker(new URL('../../../workers/loudness-worker.js', import.meta.url), { type: 'module' });
      attempt.worker.onmessage = (event) => onWorkerMessage(attempt, event.data);
      attempt.worker.onerror = () => failAttempt(attempt, 'worker_failed');
      attempt.worker.postMessage(message);
    } catch {
      failAttempt(attempt, 'worker_failed');
    }
  }

  function onWorkerMessage(attempt, message) {
    if (activeAttempt !== attempt || attempt.complete || !message || typeof message.type !== 'string') return;
    if (message.type === 'progress') {
      const value = Number(message.value);
      if (!Number.isFinite(value)) return;
      const pct = Math.max(0, Math.min(100, Math.round(value * 100)));
      statusBar.style.width = pct + '%';
      statusPct.textContent = pct + '%';
      if (typeof message.label === 'string') statusLabel.textContent = message.label;
      return;
    }
    if (message.type === 'error') return failAttempt(attempt, 'processing_failed', message.message);
    if (attempt.operation === 'analyze' && message.type === 'analysis_done') {
      const integrated = message.results?.integrated;
      if (typeof integrated !== 'number' || !Number.isFinite(integrated)) return failAttempt(attempt, 'processing_failed');
      try {
        onAnalysisComplete(integrated);
        completeAttempt(attempt);
      } catch {
        failAttempt(attempt, 'processing_failed');
      }
      return;
    }
    if (attempt.operation === 'normalize' && message.type === 'done') {
      if (!(message.buffer instanceof ArrayBuffer) || message.buffer.byteLength === 0) return failAttempt(attempt, 'processing_failed');
      try {
        const output = new Blob([message.buffer], { type: 'video/mp4' });
        if (output.size === 0) return failAttempt(attempt, 'processing_failed');
        const url = URL.createObjectURL(output);
        const link = document.createElement('a');
        link.href = url;
        link.download = currentFile.name.replace(/\.[^/.]+$/, '') + '_L24.mp4';
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 10000);
        onNormalizationComplete();
        completeAttempt(attempt);
      } catch {
        return failAttempt(attempt, 'processing_failed');
      }
    }
  }

  function completeAttempt(attempt) {
    if (activeAttempt !== attempt || attempt.complete) return;
    attempt.complete = true;
    attempt.worker?.terminate();
    activeAttempt = null;
    attempt.event.success();
  }

  function failAttempt(attempt, code, detail) {
    if (activeAttempt !== attempt || attempt.complete) return;
    attempt.complete = true;
    attempt.worker?.terminate();
    activeAttempt = null;
    attempt.event.error(code);
    showError(typeof detail === 'string' ? detail : '処理中に問題が発生しました。ファイルを確認してもう一度お試しください。');
  }

  function cancelActiveAttempt() {
    if (!activeAttempt) return;
    activeAttempt.complete = true;
    activeAttempt.worker?.terminate();
    activeAttempt.event.cancel();
    activeAttempt = null;
  }

  function onAnalysisComplete(integrated) {
    statusContainer.classList.add('hidden');
    resultsSection.classList.remove('hidden');
    
    measuredLoudness = integrated;
    resLoudness.textContent = measuredLoudness.toFixed(1);
    
    const diff = -24.0 - measuredLoudness;
    resStatusText.innerHTML = Math.abs(diff) <= 1.0
      ? '<span class="text-emerald-600">初期目標値との差は小さい状態です。</span> 提出先の仕様と再測定で確認してください。'
      : `<span class="text-amber-600">初期目標値との差は ${Math.abs(diff).toFixed(1)}dB です。</span> 提出先の仕様を確認したうえで調整してください。`;

    if (logger && logger.updateStep) {
       logger.updateStep('analyze', 'done', 'スキャン完了');
    }
  }

  btnNormalize.onclick = () => {
    if (!currentFile || measuredLoudness === null) return;
    
    statusContainer.classList.remove('hidden');
    resultsSection.classList.add('hidden');
    statusLabel.textContent = '正規化中...';
    statusBar.style.width = '0%';
    
    if (logger && logger.updateStep) {
       logger.updateStep('normalize', 'running', 'ターゲット値に合わせて調整中...');
    }
    
    startWorkerAttempt('normalize', {
      type: 'normalize', 
      file: currentFile, 
      settings: {
        currentLoudness: measuredLoudness,
        targetLoudness: -24.0
      }
    });
  };

  function onNormalizationComplete() {
    statusContainer.classList.add('hidden');
    resultsSection.classList.remove('hidden');
    if (logger && logger.updateStep) {
       logger.updateStep('normalize', 'done', 'ブラウザ内の処理が完了しました');
    }
  }

  function resetUI() {
    statusContainer.classList.add('hidden');
    resultsSection.classList.add('hidden');
    errorContainer.classList.add('hidden');
    measuredLoudness = null;
  }

  function showError(msg) {
    statusContainer.classList.add('hidden');
    resultsSection.classList.add('hidden');
    errorContainer.classList.remove('hidden');
    errorMsg.textContent = msg;
    
    if (logger && logger.updateStep) {
       logger.updateStep('analyze', 'error', '処理中にエラーが発生しました');
       logger.updateStep('normalize', 'error', '処理中にエラーが発生しました');
    }
  }
</script>
