---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout title="GlowFrame - スクリーンショットをおしゃれに装飾 - GlowPunch" description="スクリーンショットを美しい背景やウィンドウフレームで装飾し、SNS映えする画像を作成。ブラウザ完結でプライバシーも安心。">
  <div class="flex flex-col gap-8 max-w-6xl mx-auto">
    <div class="text-center md:text-left flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl md:text-5xl font-black text-slate-800 tracking-tight mb-3">Glow<span class="text-sky-500">Frame</span></h1>
        <p class="text-slate-600 text-lg">画像をドロップするだけで、SNS投稿用に美しくスタイリングします。</p>
      </div>
      <div class="flex gap-3">
         <button id="btn-export-png" class="btn-primary flex items-center gap-2 shadow-lg disabled:opacity-50 disabled:cursor-not-allowed" disabled>
           <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
           画像を保存
         </button>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Controls Panel -->
      <div class="lg:col-order-1 flex flex-col gap-6 order-2 lg:order-1">
        <div class="glass-panel p-6 space-y-8">
          <!-- Background Section -->
          <div class="space-y-4">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Background</h3>
            <div class="flex flex-wrap gap-2" id="bg-presets">
              <!-- Presets will be injected for Glow Mesh -->
              <button class="w-10 h-10 rounded-lg border-2 border-white shadow-sm transition-transform active:scale-90 bg-slate-900" data-bg="dark" title="Dark Mesh"></button>
              <button class="w-10 h-10 rounded-lg border-2 border-white shadow-sm transition-transform active:scale-90 bg-gradient-to-br from-blue-600 to-sky-400" data-bg="blue" title="Ocean Blue"></button>
              <button class="w-10 h-10 rounded-lg border-2 border-white shadow-sm transition-transform active:scale-90 bg-gradient-to-br from-rose-500 to-pink-400" data-bg="pink" title="Soft Pink"></button>
              <button class="w-10 h-10 rounded-lg border-2 border-white shadow-sm transition-transform active:scale-90 bg-gradient-to-br from-amber-500 to-orange-400" data-bg="warm" title="Warm Amber"></button>
              <button class="w-10 h-10 rounded-lg border-2 border-white shadow-sm transition-transform active:scale-90 bg-gradient-to-br from-emerald-600 to-teal-400" data-bg="emerald" title="Emerald Green"></button>
              <button class="w-10 h-10 rounded-lg border-2 border-white shadow-sm transition-transform active:scale-90 bg-gradient-to-br from-purple-600 to-indigo-400" data-bg="midnight" title="Midnight Purple"></button>
              <button class="w-10 h-10 rounded-lg border-2 border-white shadow-sm transition-transform active:scale-90 bg-gradient-to-br from-fuchsia-600 to-purple-400" data-bg="vaporwave" title="Vaporwave"></button>
              <button class="w-10 h-10 rounded-lg border-2 border-white shadow-sm transition-transform active:scale-90 bg-gradient-to-br from-cyan-500 to-blue-400" data-bg="ice" title="Ice Crystal"></button>
              <button class="w-10 h-10 rounded-lg border-2 border-white shadow-sm transition-transform active:scale-90 bg-white border-slate-200" data-bg="white" title="Pure White"></button>
            </div>
            <div class="flex items-center gap-2 overflow-hidden">
               <input type="color" id="bg-color-picker" class="w-8 h-8 rounded shrink-0 cursor-pointer" value="#0f172a" />
               <input type="text" id="bg-color-text" class="flex-grow min-w-0 text-xs font-mono p-1 border border-slate-200 rounded" value="#0F172A" />
            </div>
          </div>

          <!-- Window Section -->
          <div class="space-y-4">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Window</h3>
            <div class="space-y-3">
               <div>
                 <label class="text-sm font-medium text-slate-600 mb-1 block">Frame Style</label>
                 <select id="select-frame" class="w-full p-2 bg-slate-50 border border-slate-200 rounded-lg text-sm outline-none focus:ring-2 focus:ring-sky-500/20">
                   <option value="none">None (Minimal)</option>
                   <option value="macos">macOS (Traffic Lights)</option>
                   <option value="browser">Browser Bar</option>
                 </select>
               </div>
               <div class="flex items-center justify-between">
                 <label class="text-sm font-medium text-slate-600">Shadow</label>
                 <input type="checkbox" id="check-shadow" checked class="w-5 h-5 accent-sky-500" />
               </div>
            </div>
          </div>

          <!-- Spacing Section -->
          <div class="space-y-4 pt-2">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-widest">Spacing</h3>
            <div class="space-y-4">
              <div class="space-y-2">
                <div class="flex justify-between text-xs font-bold text-slate-500 uppercase">
                   <span>Padding</span>
                   <span id="label-padding">64px</span>
                </div>
                <input type="range" id="range-padding" min="0" max="256" value="64" class="w-full accent-sky-500" />
              </div>
              <div class="space-y-2">
                <div class="flex justify-between text-xs font-bold text-slate-500 uppercase">
                   <span>Roundness</span>
                   <span id="label-radius">16px</span>
                </div>
                <input type="range" id="range-radius" min="0" max="64" value="16" class="w-full accent-sky-500" />
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Preview Area -->
      <div class="lg:col-span-3 order-1 lg:order-2 flex flex-col gap-4">
        <div id="drop-zone" class="relative glass-panel bg-slate-50 border-2 border-dashed border-slate-300 hover:border-sky-400 hover:bg-sky-50 transition-all cursor-pointer overflow-hidden p-0 group flex items-center justify-center min-h-[500px]">
          <input type="file" id="file-input" class="hidden" accept="image/*" />
          
          <!-- Empty State -->
          <div id="empty-state" class="flex flex-col items-center gap-4 text-slate-400 p-12">
            <div class="w-16 h-16 rounded-full bg-white shadow-sm flex items-center justify-center border border-slate-200 group-hover:scale-110 transition-transform">
               <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </div>
            <div class="text-center">
              <p class="font-bold text-slate-700">画像をここにドラッグ＆ドロップ</p>
              <p class="text-sm">またはクリックしてファイルを選択</p>
            </div>
          </div>

          <!-- Preview Wrapper -->
          <div id="preview-container" class="absolute inset-0 hidden flex items-center justify-center p-16 transition-all duration-300">
             <!-- Mesh Background Layer (Matches Mesh Generator) -->
             <div id="preview-bg" class="absolute inset-0 bg-slate-900 overflow-hidden">
                <div id="mesh-layers" class="absolute inset-0 opacity-80 blur-[80px] pointer-events-none scale-125"></div>
             </div>
             
             <!-- Floating Window Layer -->
             <div id="floating-window" class="relative group/window transition-all duration-500" style="filter: drop-shadow(0 25px 50px rgba(0,0,0,0.3));">
                <!-- Frame Decoration (Trafficlights) -->
                <div id="window-frame" class="absolute top-0 left-0 right-0 h-10 flex items-center px-4 gap-2 z-10 pointer-events-none hidden bg-white/10 backdrop-blur-md rounded-t-lg">
                   <div class="w-3 h-3 rounded-full bg-[#ff5f56]"></div>
                   <div class="w-3 h-3 rounded-full bg-[#ffbd2e]"></div>
                   <div class="w-3 h-3 rounded-full bg-[#27c93f]"></div>
                </div>

                <!-- Actual Image -->
                <img id="preview-img" class="max-w-full max-h-full block object-contain shadow-2xl relative" />
             </div>
          </div>

          <!-- Reset Overlay -->
          <button id="btn-change-img" class="absolute bottom-4 right-4 px-4 py-2 rounded-lg bg-black/60 text-white text-xs font-bold backdrop-blur opacity-0 group-hover:opacity-100 transition-opacity hidden">
            画像を差し替える
          </button>
        </div>

        <div class="flex items-center justify-between text-slate-400 text-xs px-2">
           <p>※ 画像はブラウザ内で処理され、サーバーには送信されません。</p>
           <p id="img-info" class="hidden">Original: 1920x1080</p>
        </div>
      </div>
    </div>

    <!-- Instructions / SEO -->
    <article class="prose prose-slate mt-16 max-w-none border-t border-slate-200 pt-10">
      <h2>GlowFrameでスクリーンショットを「映える」作品に</h2>
      <p>
        開発中の画面や、コードの断片、デザイン案をSNSで共有するとき、ただのスクリーンショットをそのまま貼っていませんか？
        GlowFrameを使えば、数秒で以下のようなプロ仕様の画像に仕上がります。
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 not-prose mb-8">
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
          <h3 class="font-bold text-slate-800 mb-2">✨ 幻想的なメッシュ背景</h3>
          <p class="text-sm text-slate-600">流行のメッシュグラデーションを背景に。GlowMesh連携により、深みのある色彩を自由に操れます。</p>
        </div>
        <div class="bg-slate-50 p-6 rounded-2xl border border-slate-200">
          <h3 class="font-bold text-slate-800 mb-2">🍎 macOSスタイルの高級感</h3>
          <p class="text-sm text-slate-600">ウィンドウの左上に「信号機」ドットを配置。OS標準のような安心感と信頼性を演出します。</p>
        </div>
      </div>
      <h3>使い方は簡単</h3>
      <ol>
        <li>画像をドロップする</li>
        <li>余白や角の丸みを自分好みに調整</li>
        <li>「保存」ボタンを押すだけ</li>
      </ol>
      <p>
        すべての作業はローカル環境で行われるため、社外秘の情報が含まれる開発画面などでも、安心して加工いただけます。
      </p>
    </article>
  
    <div class="mt-8 border-t border-slate-200 pt-8">
      <details class="group bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
        <summary class="flex items-center justify-between p-5 font-bold text-slate-800 cursor-pointer bg-slate-50 hover:bg-slate-100 transition-colors">
          <span>GlowFrameについて（使い方・FAQ）</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-300 group-open:-rotate-180 text-slate-500"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </summary>
        <div class="p-6 text-slate-600 space-y-6">
          <div class="prose prose-slate max-w-none">
            <h3>GlowFrameについて</h3>
            <p>アプリやWebサイトのスクリーンショットを、プロフェッショナルな見た目に仕上げるツールです。ブログのアイキャッチ画像、ポートフォリオ、SNS投稿用の素材作りに最適です。</p>

            <h3>よくある質問 (FAQ)</h3>

            <h4>Q. どのような装飾ができますか？</h4>
            <p>A. グラデーション背景、ウィンドウフレーム（macOS風のドットバー付き）、角丸、パディングなどを自由にカスタマイズできます。複数のプリセットも用意しています。</p>

            <h4>Q. 出力画像の解像度は？</h4>
            <p>A. 高解像度のPNG画像として出力されます。Retinaディスプレイ対応で、ブログやSNSに掲載しても美しく表示されます。</p>

            <h4>Q. 画像はサーバーに送信されますか？</h4>
            <p>A. いいえ、すべての処理がブラウザ内で完結します。業務上のスクリーンショット等でも安心してお使いいただけます。</p>
          </div>
        </div>
      </details>
    </div>

  </div>

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "SoftwareApplication",
          "name": "GlowFrame - スクリーンショット装飾ツール",
          "operatingSystem": "All",
          "applicationCategory": "MultimediaApplication",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "JPY"
          },
          "description": "スクリーンショットを美しい背景やウィンドウフレームで装飾し、SNS映えする画像を作成する無料ツールです。"
        },
        {
          "@type": "FAQPage",
          "mainEntity": [
            {
              "@type": "Question",
              "name": "どのような装飾ができますか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "グラデーション背景、ウィンドウフレーム（macOS風のドットバー付き）、角丸、パディングなどを自由にカスタマイズできます。複数のプリセットも用意しています。"
              }
            },
            {
              "@type": "Question",
              "name": "出力画像の解像度は？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "高解像度のPNG画像として出力されます。Retinaディスプレイ対応で、ブログやSNSに掲載しても美しく表示されます。"
              }
            },
            {
              "@type": "Question",
              "name": "画像はサーバーに送信されますか？",
              "acceptedAnswer": {
                "@type": "Answer",
                "text": "いいえ、すべての処理がブラウザ内で完結します。業務上のスクリーンショット等でも安心してお使いいただけます。"
              }
            }
          ]
        }
      ]
    }
  </script>
</BaseLayout>

<style is:global>
  /* Customizing range inputs slightly for premium feel */
  input[type=range] {
    -webkit-appearance: none;
    background: transparent;
  }
  input[type=range]::-webkit-slider-thumb {
    -webkit-appearance: none;
    height: 18px;
    width: 18px;
    border-radius: 50%;
    background: white;
    border: 3px solid #0ea5e9;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    cursor: pointer;
    margin-top: -7px;
  }
  input[type=range]::-webkit-slider-runnable-track {
    width: 100%;
    height: 4px;
    background: #e2e8f0;
    border-radius: 2px;
  }
  
  .mesh-dot {
    position: absolute;
    width: 60%;
    height: 60%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    mix-blend-mode: screen;
  }
</style>

<script>
  let currentImage: HTMLImageElement | null = null;
  let currentBgMode = 'dark';
  let currentBgColor = '#0f172a';

  // Elements
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const emptyState = document.getElementById('empty-state');
  const previewContainer = document.getElementById('preview-container');
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const floatingWindow = document.getElementById('floating-window');
  const windowFrame = document.getElementById('window-frame');
  const meshLayers = document.getElementById('mesh-layers');
  const previewBg = document.getElementById('preview-bg');
  
  const rangePadding = document.getElementById('range-padding') as HTMLInputElement;
  const rangeRadius = document.getElementById('range-radius') as HTMLInputElement;
  const checkShadow = document.getElementById('check-shadow') as HTMLInputElement;
  const selectFrame = document.getElementById('select-frame') as HTMLSelectElement;
  
  const labelPadding = document.getElementById('label-padding');
  const labelRadius = document.getElementById('label-radius');
  
  const btnExport = document.getElementById('btn-export-png') as HTMLButtonElement;
  const btnChange = document.getElementById('btn-change-img');
  const imgInfo = document.getElementById('img-info');
  
  const bgPresets = document.getElementById('bg-presets');
  const bgColorPicker = document.getElementById('bg-color-picker') as HTMLInputElement;
  const bgColorText = document.getElementById('bg-color-text') as HTMLInputElement;

  // Init Glow Mesh Backgrounds
  const PRESET_COLORS = {
    dark: ['#0f172a', ['#0ea5e9', '#8b5cf6', '#d946ef', '#f43f5e']],
    blue: ['#1e40af', ['#00d2ff', '#3a7bd5', '#92fe9d', '#00c9ff']],
    pink: ['#881337', ['#833ab4', '#fd1d1d', '#fcb045', '#ff9a9e']],
    warm: ['#78350f', ['#fcd34d', '#f97316', '#ef4444', '#f43f5e']],
    emerald: ['#064e3b', ['#10b981', '#34d399', '#6ee7b7', '#059669']],
    midnight: ['#1e1b4b', ['#6366f1', '#818cf8', '#a5b4fc', '#4f46e5']],
    vaporwave: ['#4a044e', ['#ff00ff', '#00ffff', '#7028e4', '#d946ef']],
    ice: ['#0c4a6e', ['#38bdf8', '#7dd3fc', '#bae6fd', '#0284c7']],
    white: ['#f8fafc', ['#e2e8f0', '#cbd5e1', '#94a3b8', '#64748b']],
  };

  function setup() {
    // Drop Zone Listeners
    dropZone?.addEventListener('click', () => fileInput.click());
    dropZone?.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-sky-500', 'bg-sky-50');
    });
    dropZone?.addEventListener('dragleave', () => {
       dropZone.classList.remove('border-sky-500', 'bg-sky-50');
    });
    dropZone?.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-sky-500', 'bg-sky-50');
      const files = e.dataTransfer?.files;
      if (files && files.length > 0) handleFile(files[0]);
    });

    fileInput?.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.files && target.files.length > 0) handleFile(target.files[0]);
    });

    // Control Listeners
    rangePadding?.addEventListener('input', updatePreview);
    rangeRadius?.addEventListener('input', updatePreview);
    checkShadow?.addEventListener('change', updatePreview);
    selectFrame?.addEventListener('change', updatePreview);
    
    bgPresets?.addEventListener('click', (e) => {
       const btn = (e.target as HTMLElement).closest('button');
       if (btn) {
         const mode = btn.dataset.bg as keyof typeof PRESET_COLORS;
         if (mode) setBgPreset(mode);
       }
    });

    bgColorPicker?.addEventListener('input', () => {
       currentBgColor = bgColorPicker.value;
       bgColorText.value = currentBgColor.toUpperCase();
       updateBg();
    });

    btnExport?.addEventListener('click', exportImage);
    btnChange?.addEventListener('click', (e) => {
      e.stopPropagation();
      fileInput.click();
    });
    
    // Initial Bg
    setBgPreset('dark');
  }

  function handleFile(file: File) {
    if (!file.type.startsWith('image/')) return;
    
    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        currentImage = img;
        previewImg.src = img.src;
        
        emptyState?.classList.add('hidden');
        previewContainer?.classList.remove('hidden');
        btnExport.disabled = false;
        btnChange?.classList.remove('hidden');
        if (imgInfo) {
           imgInfo.classList.remove('hidden');
           imgInfo.textContent = `Original: ${img.naturalWidth}x${img.naturalHeight}`;
        }
        updatePreview();
      };
      img.src = e.target?.result as string;
    };
    reader.readAsDataURL(file);
  }

  function setBgPreset(mode: keyof typeof PRESET_COLORS) {
     currentBgMode = mode;
     currentBgColor = PRESET_COLORS[mode][0];
     bgColorPicker.value = currentBgColor;
     bgColorText.value = currentBgColor.toUpperCase();
     
     // Update Mesh Layers
     if (meshLayers) {
        meshLayers.innerHTML = '';
        const colors = PRESET_COLORS[mode][1];
        const positions = [[20, 20], [80, 30], [30, 80], [70, 70]];
        positions.forEach((pos, i) => {
           const dot = document.createElement('div');
           dot.className = 'mesh-dot';
           dot.style.left = `${pos[0]}%`;
           dot.style.top = `${pos[1]}%`;
           dot.style.backgroundColor = colors[i % colors.length] as string;
           meshLayers.appendChild(dot);
        });
     }
     updateBg();
  }

  function updateBg() {
     if (previewBg) previewBg.style.backgroundColor = currentBgColor;
  }

  function updatePreview() {
    if (!currentImage || !floatingWindow || !previewImg || !previewContainer) return;
    
    const padding = rangePadding.value;
    const radius = rangeRadius.value;
    const shadow = checkShadow.checked;
    const frame = selectFrame.value;
    
    if (labelPadding) labelPadding.textContent = `${padding}px`;
    if (labelRadius) labelRadius.textContent = `${radius}px`;
    
    previewContainer.style.padding = `${padding}px`;
    previewImg.style.borderRadius = `${radius}px`;
    
    if (shadow) {
       floatingWindow.style.filter = `drop-shadow(0 25px 50px rgba(0,0,0,0.3))`;
    } else {
       floatingWindow.style.filter = 'none';
    }

    // Frame Style
    if (frame === 'macos') {
       windowFrame?.classList.remove('hidden');
       previewImg.style.paddingTop = '40px';
       previewImg.classList.add('bg-white/10', 'backdrop-blur-xl');
       windowFrame.style.borderRadius = `${radius}px ${radius}px 0 0`;
    } else if (frame === 'browser') {
        // Simple version for now
        windowFrame?.classList.add('hidden');
        previewImg.style.paddingTop = '0';
    } else {
       windowFrame?.classList.add('hidden');
       previewImg.style.paddingTop = '0';
    }
  }

  async function exportImage() {
    if (!currentImage) return;
    
    const canvas = document.getElementById('export-canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    
    const padding = parseInt(rangePadding.value);
    const radius = parseInt(rangeRadius.value);
    const shadow = checkShadow.checked;
    const frame = selectFrame.value;
    
    // Target Resolution (keep original ratio but add padding)
    // To make it look good, we normalize to a reasonable high res
    const scale = 2; // Export at 2x for retina quality
    const imgWidth = currentImage.naturalWidth;
    const imgHeight = currentImage.naturalHeight;
    const targetWidth = (imgWidth + padding * 2) * scale;
    const targetHeight = (imgHeight + padding * 2) * scale;
    
    canvas.width = targetWidth;
    canvas.height = targetHeight;
    
    // 1. Draw Background
    ctx.fillStyle = currentBgColor;
    ctx.fillRect(0, 0, targetWidth, targetHeight);
    
    // Draw Mesh (Simulated with soft circles)
    const colors = PRESET_COLORS[currentBgMode as keyof typeof PRESET_COLORS]?.[1] || [];
    if (colors.length > 0) {
      ctx.save();
      ctx.globalCompositeOperation = 'screen';
      ctx.globalAlpha = 0.6;
      const positions = [[20, 20], [80, 30], [30, 80], [70, 70]];
      positions.forEach((pos, i) => {
        const x = (pos[0] / 100) * targetWidth;
        const y = (pos[1] / 100) * targetHeight;
        const grad = ctx.createRadialGradient(x, y, 0, x, y, targetWidth * 0.8);
        grad.addColorStop(0, colors[i % colors.length] as string);
        grad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, targetWidth, targetHeight);
      });
      ctx.restore();
    }

    // 2. Draw Image with Frame
    const destX = padding * scale;
    const destY = padding * scale;
    const destW = imgWidth * scale;
    const destH = imgHeight * scale;
    const r = radius * scale;

    ctx.save();
    if (shadow) {
       ctx.shadowColor = 'rgba(0,0,0,0.5)';
       ctx.shadowBlur = 50 * scale;
       ctx.shadowOffsetY = 20 * scale;
    }

    // Clip Rounded Rect
    ctx.beginPath();
    ctx.moveTo(destX + r, destY);
    ctx.lineTo(destX + destW - r, destY);
    ctx.quadraticCurveTo(destX + destW, destY, destX + destW, destY + r);
    ctx.lineTo(destX + destW, destY + destH - r);
    ctx.quadraticCurveTo(destX + destW, destY + destH, destX + destW - r, destY + destH);
    ctx.lineTo(destX + r, destY + destH);
    ctx.quadraticCurveTo(destX, destY + destH, destX, destY + destH - r);
    ctx.lineTo(destX, destY + r);
    ctx.quadraticCurveTo(destX, destY, destX + r, destY);
    ctx.closePath();
    ctx.fill(); // For shadow
    ctx.clip();
    
    ctx.drawImage(currentImage, destX, destY, destW, destH);
    
    // 3. Draw Decoration (macOS Dots)
    if (frame === 'macos') {
       const dotR = 6 * scale;
       const dotY = destY + 20 * scale;
       const dotXStart = destX + 24 * scale;
       const spacing = 20 * scale;
       
       // Draw a top bar semi-transparent
       ctx.fillStyle = 'rgba(255,255,255,0.1)';
       ctx.fillRect(destX, destY, destW, 40 * scale);

       [['#ff5f56'], ['#ffbd2e'], ['#27c93f']].forEach((color, i) => {
          ctx.beginPath();
          ctx.arc(dotXStart + i * spacing, dotY, dotR, 0, Math.PI * 2);
          ctx.fillStyle = color[0] as string;
          ctx.fill();
       });
    }
    
    ctx.restore();

    // 4. Download
    const link = document.createElement('a');
    link.download = `glowframe-${Date.now()}.png`;
    link.href = canvas.toDataURL('image/png');
    link.click();
  }

  setup();
</script>
