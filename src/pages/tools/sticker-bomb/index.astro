<script>
  import { removeBackground } from '@imgly/background-removal';
  import Konva from 'konva';

  // Constants
  const MAX_FILES = 30;
  const MAX_IMAGE_SIZE = 800; // Resize before processing to save memory
  const STICKER_PROBABILITY = 0.7; // 70% chance to be a cutout sticker, 30% polaroid
  const CANVAS_SIZE = 1200; // High-res export size
  const BORDER_WIDTH = 20; // Sticker border width
  
  // UI Elements
  const dropZone = document.getElementById('app-container');
  const btnSelect = document.getElementById('btn-select');
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  
  const initialUi = document.getElementById('initial-ui');
  const loadingUi = document.getElementById('loading-ui');
  const resultUi = document.getElementById('result-ui');
  
  const loadingProgressText = document.getElementById('loading-progress-text');
  const loadingStatus = document.getElementById('loading-status');
  const progressBar = document.getElementById('progress-bar');
  const processingPreview = document.getElementById('processing-preview');
  
  const konvaContainer = document.getElementById('konva-container');
  const btnDownload = document.getElementById('btn-download');
  const btnReset = document.getElementById('btn-reset');
  const btnShuffle = document.getElementById('btn-shuffle');
  const colorPickers = document.querySelectorAll('#bg-color-picker button');

  // State
  let stage: Konva.Stage | null = null;
  let layer: Konva.Layer | null = null;
  let bgLayer: Konva.Layer | null = null;
  let bgRect: Konva.Rect | null = null;
  let processedImages: { src: string, type: 'sticker' | 'polaroid', originalWidth: number, originalHeight: number }[] = [];
  let isProcessing = false;

  // Initialize Konva
  function initKonva() {
    if (stage) return;
    
    // We use a fixed internal resolution, but scale it to fit the container visually
    stage = new Konva.Stage({
      container: 'konva-container',
      width: konvaContainer?.clientWidth || 600,
      height: konvaContainer?.clientHeight || 600,
    });

    // Create background layer
    bgLayer = new Konva.Layer();
    bgRect = new Konva.Rect({
      x: 0, y: 0,
      width: CANVAS_SIZE, height: CANVAS_SIZE,
      fill: 'transparent',
    });
    bgLayer.add(bgRect);
    stage.add(bgLayer);

    // Create main items layer
    layer = new Konva.Layer();
    stage.add(layer);

    // Handle resize
    window.addEventListener('resize', fitStageIntoParentContainer);
  }

  function fitStageIntoParentContainer() {
    if (!stage || !konvaContainer) return;
    const containerWidth = konvaContainer.clientWidth;
    const containerHeight = konvaContainer.clientHeight;
    
    // The internal logical size is CANVAS_SIZE x CANVAS_SIZE
    const scale = Math.min(containerWidth / CANVAS_SIZE, containerHeight / CANVAS_SIZE);
    
    stage.width(containerWidth);
    stage.height(containerHeight);
    
    // Center the content
    const offsetX = (containerWidth - CANVAS_SIZE * scale) / 2;
    const offsetY = (containerHeight - CANVAS_SIZE * scale) / 2;
    
    stage.scale({ x: scale, y: scale });
    stage.position({ x: offsetX, y: offsetY });
  }

  // Handle Input
  btnSelect?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (target.files && target.files.length > 0) {
      handleFiles(Array.from(target.files));
    }
  });

  // Drag & Drop
  ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(evt => {
    dropZone?.addEventListener(evt, (e) => { e.preventDefault(); e.stopPropagation(); }, false);
  });
  
  ['dragenter', 'dragover'].forEach(evt => {
    dropZone?.addEventListener(evt, () => dropZone?.classList.add('border-pink-400', 'bg-pink-50/30'), false);
  });
  
  ['dragleave', 'drop'].forEach(evt => {
    dropZone?.addEventListener(evt, () => dropZone?.classList.remove('border-pink-400', 'bg-pink-50/30'), false);
  });
  
  dropZone?.addEventListener('drop', (e: DragEvent) => {
    if (isProcessing) return;
    const dt = e.dataTransfer;
    if (dt && dt.files && dt.files.length > 0) {
      handleFiles(Array.from(dt.files));
    }
  });

  // Flow Controller
  async function handleFiles(files: File[]) {
    const imageFiles = files.filter(f => f.type.startsWith('image/')).slice(0, MAX_FILES);
    if (imageFiles.length === 0) return alert('画像ファイルを選択してください');

    isProcessing = true;
    processedImages = [];
    
    // UI Update
    initialUi?.classList.add('hidden');
    loadingUi?.classList.remove('hidden');
    loadingUi?.classList.add('flex');
    if (processingPreview) processingPreview.innerHTML = '';
    
    initKonva();

    // Process Queue
    for (let i = 0; i < imageFiles.length; i++) {
      if (loadingProgressText) loadingProgressText.textContent = `${i + 1} / ${imageFiles.length} 枚を処理中...`;
      if (progressBar) progressBar.style.width = `${((i) / imageFiles.length) * 100}%`;
      
      try {
        await processSingleImage(imageFiles[i]);
      } catch (err) {
        console.error(`Error processing image ${i}:`, err);
        // Continue to next even if one fails
      }
    }

    if (progressBar) progressBar.style.width = `100%`;
    if (loadingStatus) loadingStatus.textContent = "配置しています...";

    // All done, render Konva
    renderCollage();

    // Switch UI
    loadingUi?.classList.add('hidden');
    loadingUi?.classList.remove('flex');
    resultUi?.classList.remove('hidden');
    resultUi?.classList.add('flex');
    fitStageIntoParentContainer();
    
    isProcessing = false;
  }

  // Process a single image
  async function processSingleImage(file: File) {
    // 1. Load and resize
    const imgUrl = URL.createObjectURL(file);
    const imgObj = await loadImage(imgUrl);
    URL.revokeObjectURL(imgUrl);

    const { canvas: resizedCanvas, width: rw, height: rh } = resizeCanvas(imgObj, MAX_IMAGE_SIZE);
    
    // Decide style
    const isSticker = Math.random() < STICKER_PROBABILITY;

    let finalDataUrl = '';

    if (isSticker) {
      if (loadingStatus) loadingStatus.textContent = "AI被写体認識中...";
      
      // Convert to blob for imgly
      const blob = await new Promise<Blob>((resolve) => resizedCanvas.toBlob(b => resolve(b!), 'image/jpeg', 0.9));
      
      // Remove Background
      const transparentBlob = await removeBackground(blob, {
        progress: (key, current, total) => {
          // Ignore granular progress to avoid flickering, just show status
        }
      });
      
      if (loadingStatus) loadingStatus.textContent = "縁取りエフェクト生成中...";
      
      // Add Sticker Border
      const transImgUrl = URL.createObjectURL(transparentBlob);
      const transImgObj = await loadImage(transImgUrl);
      URL.revokeObjectURL(transImgUrl);
      
      finalDataUrl = createStickerBorder(transImgObj, BORDER_WIDTH, '#ffffff');
      
      processedImages.push({
        src: finalDataUrl,
        type: 'sticker',
        originalWidth: transImgObj.width,
        originalHeight: transImgObj.height
      });
    } else {
      // Polaroid style (no AI needed)
      if (loadingStatus) loadingStatus.textContent = "ポラロイド化処理中...";
      finalDataUrl = createPolaroid(resizedCanvas);
      
      processedImages.push({
        src: finalDataUrl,
        type: 'polaroid',
        originalWidth: Math.min(rw, rh),
        originalHeight: Math.min(rw, rh)
      });
    }

    // Add thumbnail to preview
    if (processingPreview) {
      const thumb = document.createElement('img');
      thumb.src = finalDataUrl;
      thumb.className = "w-12 h-12 object-contain bg-slate-100 rounded border border-slate-200 shadow-sm";
      processingPreview.appendChild(thumb);
    }
  }

  // --- Helper Functions ---

  function loadImage(src: string): Promise<HTMLImageElement> {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.crossOrigin = "Anonymous";
      img.onload = () => resolve(img);
      img.onerror = reject;
      img.src = src;
    });
  }

  function resizeCanvas(img: HTMLImageElement, maxSize: number) {
    const canvas = document.createElement('canvas');
    let width = img.width;
    let height = img.height;

    if (width > maxSize || height > maxSize) {
      if (width > height) {
        height = Math.round((height * maxSize) / width);
        width = maxSize;
      } else {
        width = Math.round((width * maxSize) / height);
        height = maxSize;
      }
    }

    canvas.width = width;
    canvas.height = height;
    const ctx = canvas.getContext('2d');
    if (ctx) ctx.drawImage(img, 0, 0, width, height);
    
    return { canvas, width, height };
  }

  function createStickerBorder(img: HTMLImageElement, border: number, color: string) {
    const canvas = document.createElement('canvas');
    canvas.width = img.width + border * 2;
    canvas.height = img.height + border * 2;
    const ctx = canvas.getContext('2d');
    if (!ctx) return '';

    // Create solid mask
    const maskCanvas = document.createElement('canvas');
    maskCanvas.width = img.width;
    maskCanvas.height = img.height;
    const mCtx = maskCanvas.getContext('2d');
    if (mCtx) {
      mCtx.drawImage(img, 0, 0);
      mCtx.globalCompositeOperation = 'source-in';
      mCtx.fillStyle = color;
      mCtx.fillRect(0, 0, img.width, img.height);
    }

    // Draw mask around center
    const angles = 32;
    for (let i = 0; i < angles; i++) {
      const angle = (i / angles) * Math.PI * 2;
      const dx = border + Math.cos(angle) * border;
      const dy = border + Math.sin(angle) * border;
      ctx.drawImage(maskCanvas, dx, dy);
    }

    // Drop shadow on the border to make it pop
    ctx.shadowColor = 'rgba(0,0,0,0.15)';
    ctx.shadowBlur = 10;
    ctx.shadowOffsetX = 2;
    ctx.shadowOffsetY = 4;
    
    // Redraw once more to apply shadow, then original
    ctx.drawImage(canvas, 0, 0);
    ctx.shadowColor = 'transparent';
    
    // Draw original
    ctx.drawImage(img, border, border);
    
    return canvas.toDataURL('image/png');
  }

  function createPolaroid(canvas: HTMLCanvasElement) {
    const minDim = Math.min(canvas.width, canvas.height);
    const size = minDim;
    
    const outCanvas = document.createElement('canvas');
    const padding = 20;
    const bottomPadding = 60;
    outCanvas.width = size + padding * 2;
    outCanvas.height = size + padding + bottomPadding;
    const ctx = outCanvas.getContext('2d');
    if (!ctx) return '';

    // Shadow
    ctx.shadowColor = 'rgba(0,0,0,0.15)';
    ctx.shadowBlur = 12;
    ctx.shadowOffsetY = 4;

    // White paper
    ctx.fillStyle = '#ffffff';
    ctx.fillRect(5, 5, outCanvas.width - 10, outCanvas.height - 10);
    
    ctx.shadowColor = 'transparent';

    // Crop center square
    const sx = (canvas.width - size) / 2;
    const sy = (canvas.height - size) / 2;
    ctx.drawImage(canvas, sx, sy, size, size, padding, padding, size, size);

    return outCanvas.toDataURL('image/png');
  }

  // --- Konva Rendering ---

  async function renderCollage() {
    if (!layer || !stage) return;
    layer.destroyChildren();

    // Center and spread logic
    const centerX = CANVAS_SIZE / 2;
    const centerY = CANVAS_SIZE / 2;
    const spreadRadius = CANVAS_SIZE * 0.35; // How far items can spread from center

    for (const item of processedImages) {
      const img = await loadImage(item.src);
      
      // Calculate scale to fit nicely in collage
      // We want items to be roughly 1/3 to 1/4 of the canvas size
      const targetMaxDim = CANVAS_SIZE * (item.type === 'polaroid' ? 0.3 : 0.4);
      const scale = targetMaxDim / Math.max(img.width, img.height);
      
      // Random position with a bias towards center
      const angle = Math.random() * Math.PI * 2;
      const r = Math.random() * spreadRadius;
      const x = centerX + Math.cos(angle) * r;
      const y = centerY + Math.sin(angle) * r;
      
      const rotation = (Math.random() - 0.5) * 40; // -20 to 20 degrees

      const konvaImg = new Konva.Image({
        x: x,
        y: y,
        image: img,
        scaleX: scale,
        scaleY: scale,
        rotation: rotation,
        draggable: true,
        offsetX: img.width / 2,
        offsetY: img.height / 2,
      });

      // Hover cursors
      konvaImg.on('mouseenter', () => document.body.style.cursor = 'grab');
      konvaImg.on('mouseleave', () => document.body.style.cursor = 'default');
      konvaImg.on('mousedown touchstart', () => {
        document.body.style.cursor = 'grabbing';
        konvaImg.moveToTop();
        layer?.draw();
      });
      konvaImg.on('mouseup touchend', () => document.body.style.cursor = 'grab');

      layer.add(konvaImg);
    }

    layer.draw();
  }

  // Actions
  btnShuffle?.addEventListener('click', () => {
    if (!layer) return;
    const centerX = CANVAS_SIZE / 2;
    const centerY = CANVAS_SIZE / 2;
    const spreadRadius = CANVAS_SIZE * 0.35;

    layer.getChildren().forEach(node => {
      const angle = Math.random() * Math.PI * 2;
      const r = Math.random() * spreadRadius;
      node.to({
        x: centerX + Math.cos(angle) * r,
        y: centerY + Math.sin(angle) * r,
        rotation: (Math.random() - 0.5) * 40,
        duration: 0.3,
        easing: Konva.Easings.EaseOut
      });
    });
  });

  colorPickers.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const color = target.dataset.color || 'transparent';
      if (bgRect && bgLayer) {
        bgRect.fill(color);
        bgLayer.draw();
      }
    });
  });

  btnDownload?.addEventListener('click', () => {
    if (!stage) return;
    
    // We want to export at CANVAS_SIZE resolution, regardless of current container scale
    const originalScaleX = stage.scaleX();
    const originalScaleY = stage.scaleY();
    const originalX = stage.x();
    const originalY = stage.y();

    stage.scale({ x: 1, y: 1 });
    stage.position({ x: 0, y: 0 });
    stage.width(CANVAS_SIZE);
    stage.height(CANVAS_SIZE);

    const dataURL = stage.toDataURL({ pixelRatio: 2 }); // 2x for retina quality

    // Restore
    stage.scale({ x: originalScaleX, y: originalScaleY });
    stage.position({ x: originalX, y: originalY });
    fitStageIntoParentContainer();

    const link = document.createElement('a');
    link.download = `sticker-bomb-${Date.now()}.png`;
    link.href = dataURL;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  });

  btnReset?.addEventListener('click', () => {
    if (fileInput) fileInput.value = '';
    processedImages = [];
    if (layer) { layer.destroyChildren(); layer.draw(); }
    
    resultUi?.classList.add('hidden');
    resultUi?.classList.remove('flex');
    initialUi?.classList.remove('hidden');
    
    if (progressBar) progressBar.style.width = '0%';
  });

</script>
