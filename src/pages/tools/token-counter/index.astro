---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AdSensePlaceholder from '../../../components/AdSensePlaceholder.astro';
---

<BaseLayout title="LLMトークンカウンター - GlowPunch" description="ChatGPT等のプロンプトのトークン数をブラウザ内で安全に計算。機密情報も一切外部に送信されません。">
  <div class="flex flex-col gap-6">
    <div class="mb-4">
      <h1 class="text-3xl md:text-4xl font-bold text-slate-800 tracking-tight mb-2">LLMトークン<span class="text-purple-500">カウンター</span></h1>
      <p class="text-slate-600 text-lg">ChatGPT等のプロンプトトークン数を瞬時に計算。データは外部に送信されません。</p>
    </div>

    <!-- Stats Dashboard -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-2">
      <div class="glass-panel p-5 flex flex-col items-center justify-center relative overflow-hidden group">
        <span class="text-slate-500 text-[0.8rem] font-medium mb-1 tracking-wider">トークン数 (GPT-5.4)</span>
        <span class="text-4xl md:text-5xl font-black text-purple-600" id="stat-tokens">0</span>
      </div>
      <div class="glass-panel p-5 flex flex-col items-center justify-center relative overflow-hidden group">
        <span class="text-slate-500 text-sm font-medium mb-1 tracking-wider">文字数</span>
        <span class="text-4xl md:text-5xl font-black text-slate-800" id="stat-chars">0</span>
      </div>
      <div class="glass-panel p-5 flex flex-col items-center justify-center relative overflow-hidden group">
        <span class="text-slate-500 text-[0.8rem] font-medium mb-1 tracking-wider">1トークンあたりの文字</span>
        <span class="text-4xl md:text-5xl font-black text-slate-800" id="stat-ratio">0.0</span>
      </div>
      <div class="glass-panel p-5 flex flex-col items-center justify-center relative overflow-hidden group">
        <span class="text-slate-500 text-[0.8rem] font-medium mb-1 tracking-wider">API入力費用(GPT-5.4)</span>
        <span class="text-4xl md:text-5xl font-black text-slate-800" id="stat-cost">$0</span>
      </div>
    </div>

    <!-- Text Area -->
    <div class="glass-panel p-1 rounded-2xl relative group focus-within:ring-2 focus-within:ring-purple-500/50 transition-all bg-white border border-slate-300 shadow-inner">
      <textarea 
        id="text-input"
        class="w-full h-80 bg-transparent rounded-xl outline-none border-none p-6 text-slate-800 placeholder-slate-400 resize-y focus:outline-none focus:ring-0 font-sans text-lg appearance-none"
        placeholder="プロンプトを入力、または貼り付けてください..."
      ></textarea>
    </div>

    <!-- Actions -->
    <div class="flex flex-wrap gap-4 mt-2">
      <button id="btn-copy" class="px-6 py-3 rounded-xl font-bold text-white bg-purple-500 border border-transparent transition-all duration-300 hover:bg-purple-600 hover:shadow-md active:scale-95 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
        テキストをコピー
      </button>
      <button id="btn-clear" class="px-6 py-3 rounded-xl font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 border border-slate-300 transition-colors flex items-center gap-2 active:scale-95">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
        クリア
      </button>
    </div>

    <div class="mt-12">
      <AdSensePlaceholder slotId="tool-bottom-banner" />
    </div>

    <!-- SEO content hidden below the fold -->
    <article class="prose prose-slate mt-16 max-w-none border-t border-slate-200 pt-10">
      <h2>LLMトークンカウンターについて</h2>
      <p>このツールは、ChatGPT（GPT-5.4 / GPT-4など）やその他の大規模言語モデル（LLM）に入力するテキストの「トークン数」を、ローカル環境で安全に素早く計算するツールです。</p>
      <h3>安全に計算できる理由</h3>
      <ul>
        <li><strong>完全ローカル処理:</strong> トークンの計算処理はすべてあなたのブラウザ上で行われます。機密情報や社外秘のプロンプトを外部サーバーに送信することなく、安全にトークン数を把握できます。</li>
        <li><strong>最新のエンコーディング:</strong> 内部では <code>cl100k_base</code> エンコーディングをブラウザに移植したライブラリを使用しており、公式と同等の正確さでカウントします。</li>
      </ul>
      <p>API費用の見積もりや、コンテキストウィンドウの制限確認にご活用ください。</p>
    </article>
  </div>
</BaseLayout>

<script>
  import { encode } from 'gpt-tokenizer';

  const input = document.getElementById('text-input') as HTMLTextAreaElement | null;
  const statTokens = document.getElementById('stat-tokens');
  const statChars = document.getElementById('stat-chars');
  const statRatio = document.getElementById('stat-ratio');
  const statCost = document.getElementById('stat-cost');
  const btnCopy = document.getElementById('btn-copy');
  const btnClear = document.getElementById('btn-clear');

  function updateStats() {
    if (!input || !statTokens || !statChars || !statRatio || !statCost) return;
    
    const text = input.value;
    
    // Characters
    const charCount = text.length;
    statChars.textContent = charCount.toLocaleString();
    
    // Tokens
    let tokenCount = 0;
    if (text.length > 0) {
      try {
        const tokens = encode(text);
        tokenCount = tokens.length;
      } catch (e) {
        console.error("Tokenization error:", e);
      }
    }
    statTokens.textContent = tokenCount.toLocaleString();
    
    // Ratio (Chars per Token)
    let ratio = 0;
    if (tokenCount > 0) {
      ratio = charCount / tokenCount;
    }
    statRatio.textContent = ratio.toFixed(2);
    
    // Cost estimation (GPT-5.4 input cost is $2.50 / 1M tokens)
    const costPerMillion = 2.50;
    const estimatedCost = (tokenCount / 1000000) * costPerMillion;
    statCost.textContent = estimatedCost > 0 ? `~$${estimatedCost.toFixed(4)}` : '$0';
  }

  input?.addEventListener('input', updateStats);

  btnCopy?.addEventListener('click', async () => {
    if (input) {
      try {
        await navigator.clipboard.writeText(input.value);
        const originalText = btnCopy.innerHTML;
        btnCopy.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-300"><polyline points="20 6 9 17 4 12"/></svg> コピーしました！`;
        setTimeout(() => {
          btnCopy.innerHTML = originalText;
        }, 2000);
      } catch (err) {
        console.error('Failed to copy text: ', err);
      }
    }
  });

  btnClear?.addEventListener('click', () => {
    if (input) {
      input.value = '';
      updateStats();
      input.focus();
    }
  });
  
  // initialize state
  updateStats();
</script>
