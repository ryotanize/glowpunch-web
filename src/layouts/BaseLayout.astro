---
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import '../styles/global.css';
import ToolContext from '../components/ToolContext.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  article?: boolean;
}

const { title, description, noindex = false, article = false } = Astro.props;
const preview = import.meta.env.CF_PAGES === '1' && import.meta.env.CF_PAGES_BRANCH !== 'main';
const toolId = Astro.url.pathname.match(/^\/tools\/([^/]+)/)?.[1];
const adsEnabled = !preview && !noindex && import.meta.env.PUBLIC_ADSENSE_ENABLED === 'true';
const siteRevision = import.meta.env.CF_PAGES_COMMIT_SHA;
const validSiteRevision = typeof siteRevision === 'string' && /^[a-f0-9]{40}$/.test(siteRevision);
const releaseManifest = validSiteRevision ? JSON.stringify({ schemaVersion: 1, siteRevision, measurementVersion: 1 }) : undefined;
---

<!doctype html>
<html lang="ja">
  <head>
    <SEO title={title} description={description} noindex={noindex || preview} article={article} />
    <meta name="google-adsense-account" content="ca-pub-6865502337555505" />
    <meta name="referrer" content="strict-origin" />
    {releaseManifest && <script id="gp-release-manifest" type="application/json" set:html={releaseManifest} />}
    {!preview && !noindex && <GoogleAnalytics pagePath={Astro.url.pathname} pageTitle={title ?? ''} siteRevision={validSiteRevision ? siteRevision : undefined} />}
    {adsEnabled && <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6865502337555505" crossorigin="anonymous"></script>}
  </head>
  <body class="min-h-screen flex flex-col selection:bg-sky-200">
    <a href="#main-content" class="skip-link">本文へ移動</a>
    <Header />
    <main id="main-content" tabindex="-1" class="flex-grow max-w-[1200px] w-full mx-auto px-4 pt-8 pb-12 overflow-x-hidden flex flex-col gap-8">
      <slot />
      {toolId && <ToolContext id={toolId} />}
    </main>
    <Footer />
  </body>
</html>

<script>
  // Existing drop zones remain usable with a keyboard as well as drag-and-drop.
  document.querySelectorAll<HTMLElement>('#drop-zone, #dropzone').forEach(zone => {
    if (zone instanceof HTMLButtonElement || zone instanceof HTMLLabelElement) return;
    zone.setAttribute('role', 'button');
    zone.tabIndex = 0;
    zone.setAttribute('aria-label', '処理するファイルを選択');
    zone.addEventListener('keydown', event => {
      if (event.target !== zone) return;
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        zone.click();
      }
    });
  });
</script>
