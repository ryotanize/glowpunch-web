---
const links = [['/#tools', 'ツール一覧'], ['/blog/', 'ガイド・記事'], ['/guide/', '使い方'], ['/about/', 'GlowPunchについて']];
---
<header class="w-full border-b border-slate-200 bg-white">
  <div class="max-w-[1200px] mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-4">
    <a href="/" class="font-black text-2xl text-sky-800">GlowPunch<span class="block text-xs font-medium text-slate-600 mt-1">ファイル処理を、ブラウザ内で。</span></a>
    <nav aria-label="メインナビゲーション" class="flex flex-wrap gap-x-5 gap-y-1 text-sm font-semibold">
      {links.map(([href, label]) => <a href={href} class="py-3 hover:text-sky-700" aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
    </nav>
  </div>
</header>
