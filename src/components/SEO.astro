---
export interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalURL?: string;
  noindex?: boolean;
  article?: boolean;
}

const {
  title = "ファイルをアップロードしない無料ブラウザツール | GlowPunch",
  description = "処理対象ファイルを外部サーバーへアップロードせず、ブラウザ内で加工する無料ツール集。PDF・画像・動画・音声の作業と実用ガイド。",
  image = "/og-image.png",
  noindex = false,
  article = false,
  canonicalURL = new URL(Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "") + "/", Astro.site || "https://glowpunch.net").href,
} = Astro.props;
---

<title>{title}</title>
{noindex && <meta name="robots" content="noindex, follow" />}
<meta name="description" content={description} />
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site || "https://glowpunch.net")} />

<meta property="og:locale" content="ja_JP" />
<meta property="og:site_name" content="GlowPunch" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site || "https://glowpunch.net")} />
